rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'safeness.c.a@gmail.com';
    }
    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.token.email.lower());
    }
    function hasAdminRecord() {
      return signedIn() && request.auth.token.email != null && exists(adminPath());
    }
    function role() {
      return hasAdminRecord() ? get(adminPath()).data.role : 'usuario';
    }
    function hasRole(roles) {
      return owner() || (hasAdminRecord() && role() in roles);
    }
    function canOperate() {
      return hasRole(['super_admin','super_usuario','ceo','admin','supervisor','colaborador','usuario']);
    }
    function canManageCommercial() {
      return hasRole(['super_admin','super_usuario','ceo','admin','supervisor','colaborador']);
    }
    function canManageFinance() {
      return hasRole(['super_admin','super_usuario','ceo','admin','financeiro']);
    }
    function canManagePayroll() {
      return hasRole(['super_admin','super_usuario','ceo','admin','financeiro','rh']);
    }
    function canManageQuality() {
      return hasRole(['super_admin','super_usuario','ceo','admin','supervisor','colaborador','qualidade']);
    }
    function canManageInventory() {
      return hasRole(['super_admin','super_usuario','ceo','admin','financeiro','estoque','producao']);
    }
    function canManageProduction() {
      return hasRole(['super_admin','super_usuario','ceo','admin','supervisor','producao']);
    }

    match /admins/{email} {
      allow read: if signedIn() && (request.auth.token.email.lower() == email || owner() || canManagePayroll());
      allow create, update, delete: if owner();
      allow update: if canManagePayroll()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedAt','deletedBy']);
    }
    match /pending_users/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow update: if canManagePayroll()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedAt','deletedBy']);
      allow read: if (signedIn() && request.auth.uid == uid) || owner() || canManagePayroll();
      allow delete: if owner();
    }

    // Comercial: clientes, propostas, faturação e catálogo.
    match /companies/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /companies_crm/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /budgets/{id} {
 allow read: if canOperate() || canManageFinance();
 allow create: if canManageCommercial() || (request.resource.data.requestOnly == true && request.resource.data.source == 'website' && request.resource.data.status == 'pending' && !('total' in request.resource.data) && !('subtotal' in request.resource.data) && !('taxRate' in request.resource.data) && !('taxAmount' in request.resource.data));
 allow update: if canManageCommercial();
 allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']);
}
    match /quotes/{id} {
      allow read: if canOperate() || canManageProduction() || canManageFinance() || canManageQuality();
      allow create: if canManageCommercial();
      allow update: if (
        (canManageCommercial() || canManageFinance()) && (
          !('approvedSnapshotId' in resource.data) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','invoiceId','invoicedAt','updatedAt','clientAdvanceTotal','balanceDue','productionStatus','productionOrderId','deliveryId','deliveryStatus','deliveredAt','deliveryEvidence'])
        )
      ) || (
        canManageProduction() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'productionStatus','productionOrderId','updatedAt'
        ])
      ) || (
        canManageQuality() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'productionStatus','qualityStatus','qualityRecordId','qualityInspectedAt','updatedAt'
        ])
      ) || (
        (canManageCommercial() || canManageFinance())
        && request.resource.data.status == 'draft'
        && !('approvedSnapshotId' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'number','companyId','clientName','clientEmail','clientTaxId','clientAddress','clientNif',
          'date','validUntil','items','itemIds','technicalDrawing','subtotal','labor','marginRate',
          'margin','freight','taxRate','taxAmount','discountRate','discountAmount','total','currency',
          'status','notes','updatedAt','approvedSnapshotId','approvedAt','approvedBy','snapshotContentHash'
        ])
      );
      allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']);
    }
    match /ledger_entries/{id} {
      allow read: if canManageFinance() || (hasRole(['rh']) && resource.data.category in ['employee_advance','payroll']);
      allow create: if canManageFinance() || (hasRole(['rh']) && request.resource.data.category in ['employee_advance','payroll']);
      allow update: if canManageFinance() || (hasRole(['rh'])
        && resource.data.category == 'employee_advance'
        && request.resource.data.category == 'employee_advance'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled','settledAt','payrollPaymentId']));
      allow delete: if canManageFinance();
    }
    match /daily_expenses/{id} { allow read, write: if canManageFinance(); }
    match /client_advances/{id} { allow read, write: if canManageFinance(); }
    match /purchase_orders/{id} { allow read, write: if canManageFinance(); }
    match /payables/{id} { allow read, write: if canManageFinance(); }
    match /payments/{id} {
      allow read, update, delete: if canManageFinance();
      allow create: if canManageFinance() || (hasRole(['rh']) && request.resource.data.category == 'payroll'
        && request.resource.data.sourceType == 'employee_payment');
    }
    match /receivables/{id} { allow read, write: if canManageFinance(); }
    match /suppliers/{id} { allow read, write: if canManageFinance(); }
    match /payroll_adjustments/{id} { allow read, write: if canManagePayroll(); }
    match /employees/{id} {
      allow read, create, update, delete: if canManagePayroll();
    }
    match /funcionarios/{id} {
      allow read, create, update, delete: if canManagePayroll();
    }
    match /employee_advances/{id} { allow read: if canManagePayroll(); allow write: if canManageFinance(); }
    match /advances/{id} { allow read: if canManagePayroll(); allow write: if canManageFinance(); }
    match /transactions/{id} { allow read: if canManageFinance(); }
    match /employee_payments/{id} { allow read, write: if canManagePayroll(); }
    match /time_entries/{id} { allow read, write: if canManagePayroll(); }
    match /production_orders/{id} {
      allow read: if canOperate() || canManageProduction() || canManageFinance() || canManageQuality();
      allow create: if canManageProduction() || canManageFinance() || canManageCommercial();
      allow update: if canManageProduction() || canManageFinance() || (
        canManageCommercial() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','workflowStage','nextStep','deliveryId','deliveryStatus','deliveredAt',
          'invoiceId','invoiceNumber','invoiceStatus','paymentStatus','paidAt','updatedAt'
        ])
      ) || (
        canManageQuality() && resource.data.workflowStage == 'POS_VENDA_E_GARANTIA'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'workflowChecklist','updatedAt','lastWorkflowUpdateBy','workflowStage','workflowStageIndex',
          'workflowCompletedAt','history','lastStageChangedAt','lastStageChangedBy','status'
        ])
      ) || (
        canManageQuality() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','workflowStage','nextStep','qualityStatus','qualityRecordId','qualityInspectedAt','updatedAt'
        ])
      );
      allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']);
    }
    match /user_profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || owner() || canManagePayroll());
      allow write: if signedIn() && (request.auth.uid == uid || owner());
      allow update: if canManagePayroll()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedAt','deletedBy']);
    }
    match /staff/{id} {
      allow read: if canManagePayroll();
      allow create, update, delete: if canManagePayroll();
    }
    match /agenda_slots/{id} { allow read: if true; allow write: if hasRole(['super_admin','super_usuario','ceo','admin','supervisor']); }
    match /chat_sessions/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if owner() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if owner() || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if owner();
    }
    match /post_sale_records/{id} {
      allow read: if canOperate() || canManageQuality();
      allow create: if canOperate() || canManageQuality();
      allow update, delete: if canManageQuality();
    }
    match /tipologias/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /projects/{id} {
      allow read: if canOperate();
      allow create: if canManageCommercial();
      allow update: if canManageCommercial() || (canManageFinance() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['productionStatus','updatedAt']));
      allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']);
    }
    match /user_suggestions/{id} { allow read: if canOperate(); allow create: if canOperate(); allow update, delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /invoices/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial() || canManageFinance(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /catalog/{id} { allow read: if canOperate() || canManageFinance() || canManageQuality() || canManageProduction(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /price_table/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /supplier_catalog/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /registry_items/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /registry_products/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /registry_services/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /payment_methods/{id} { allow read: if canOperate(); allow create, update, delete: if canManageFinance(); }
    match /measurement_sheets/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /contracts/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /cut_plans/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /profile_optimization/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /material_lists/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /technical_drawings/{id} {
      allow read: if canOperate() || canManageQuality() || canManageProduction();
      allow create: if canManageCommercial() || canManageQuality() || canManageProduction();
      allow update: if (canManageCommercial() || canManageQuality() || canManageProduction()) && !('approvedSnapshotId' in resource.data);
      allow delete: if canManageCommercial() && !('approvedSnapshotId' in resource.data);
    }
    match /drawing_jobs/{id} {
      allow create: if (canManageCommercial() || canManageQuality() || canManageProduction())
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.status == 'PROCESSING';
      allow read: if (signedIn() && resource.data.userUid == request.auth.uid)
        || owner() || hasRole(['super_admin','super_usuario','ceo','admin','supervisor','qualidade','producao']);
      allow update: if (signedIn() && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','result','completedAt','error','updatedAt']))
        || owner();
      allow delete: if owner();
    }
    match /approved_snapshots/{id} {
      allow read: if canManageCommercial() || canManageFinance() || canManageQuality() || canManageProduction();
      allow create: if canManageCommercial() || canManageFinance() || canManageQuality() || canManageProduction();
      allow update, delete: if false;
    }
    match /ai_audit_logs/{id} {
      allow read: if hasRole(['super_admin','super_usuario','ceo','admin']);
      allow create: if canManageCommercial() || canManageFinance() || canManageQuality() || canManageProduction();
      allow update, delete: if false;
    }
    match /budget_line_audit/{id} {
      allow read: if canManageCommercial() || canManageFinance() || canManageQuality() || canManageProduction();
      allow create: if canManageCommercial() || canManageFinance() || canManageQuality() || canManageProduction();
      allow update, delete: if false;
    }
    match /sender_config/{id} { allow read: if canOperate(); allow create, update: if hasRole(['super_admin','super_usuario','ceo','admin']); allow delete: if owner(); }

    // Negação por padrão: nenhuma coleção não declarada fica acessível por estar autenticado.
    // Os perfis de administração têm acesso integral a todas as coleções do sistema.
    match /{document=**} { allow read, write: if hasRole(['super_admin','super_usuario','ceo','admin']); }
  }
}