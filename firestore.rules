rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'safeness.c.a@gmail.com';
    }
    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.token.email.lower());
    }
    function hasAdminRecord() {
      return signedIn() && request.auth.token.email != null && exists(adminPath());
    }
    function role() {
      return hasAdminRecord() ? get(adminPath()).data.role : 'usuario';
    }
    function hasRole(roles) {
      return owner() || (hasAdminRecord() && role() in roles);
    }
    function canOperate() {
      return hasRole(['super_admin','super_usuario','ceo','admin','supervisor','colaborador','usuario']);
    }
    function canManageCommercial() {
      return hasRole(['super_admin','super_usuario','ceo','admin','supervisor','colaborador']);
    }
    function canManageFinance() {
      return hasRole(['super_admin','super_usuario','ceo','admin','financeiro']);
    }
    function canManageQuality() {
      return hasRole(['super_admin','super_usuario','ceo','admin','supervisor','colaborador','qualidade']);
    }
    function canManageInventory() {
      return hasRole(['super_admin','super_usuario','ceo','admin','financeiro','estoque','producao']);
    }
    function canManageProduction() {
      return hasRole(['super_admin','super_usuario','ceo','admin','supervisor','producao']);
    }

    match /admins/{email} {
      allow read: if signedIn() && (request.auth.token.email.lower() == email || owner());
      allow create, update, delete: if owner();
    }
    match /pending_users/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read: if (signedIn() && request.auth.uid == uid) || owner();
      allow delete: if owner();
    }

    // Comercial: clientes, propostas, faturação e catálogo.
    match /companies/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /companies_crm/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /budgets/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /quotes/{id} {
      allow read: if canOperate() || canManageProduction();
      allow create: if canManageCommercial();
      allow update: if canManageCommercial() && (
        !('approvedSnapshotId' in resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','invoiceId','invoicedAt','updatedAt'])
      );
      allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']) && !('approvedSnapshotId' in resource.data);
    }
    match /ledger_entries/{id} { allow read, write: if canManageFinance(); }
    match /user_profiles/{uid} { allow read, write: if signedIn() && (request.auth.uid == uid || owner()); }
    match /chat_sessions/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if owner() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if owner() || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if owner();
    }
    match /tipologias/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /projects/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /user_suggestions/{id} { allow read: if canOperate(); allow create: if canOperate(); allow update, delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /invoices/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial() || canManageFinance(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /catalog/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /supplier_catalog/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /registry_items/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /registry_products/{id} { allow read: if canOperate() || canManageFinance(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /registry_services/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /payment_methods/{id} { allow read: if canOperate(); allow create, update, delete: if canManageFinance(); }
    match /measurement_sheets/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /contracts/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /cut_plans/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /profile_optimization/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /material_lists/{id} { allow read: if canOperate(); allow create, update: if canManageCommercial(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /technical_drawings/{id} {
      allow read: if canOperate();
      allow create: if canManageCommercial();
      allow update: if (canManageCommercial() || canManageQuality() || canManageProduction()) && !('approvedSnapshotId' in resource.data);
      allow delete: if canManageCommercial() && !('approvedSnapshotId' in resource.data);
    }
    match /approved_snapshots/{id} {
      allow read: if canOperate() || canManageFinance() || canManageQuality() || canManageProduction();
      allow create: if canManageCommercial() || canManageFinance() || canManageQuality() || canManageProduction();
      allow update, delete: if false;
    }

    // Tabela central de preços e rastreabilidade das atualizações.
    match /price_table/{id} {
      allow read: if canOperate() || canManageFinance();
      allow create, update: if canManageCommercial();
      allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']);
    }
    match /price_history/{id} {
      allow read: if canOperate() || canManageFinance();
      allow create: if canManageCommercial();
      allow update, delete: if hasRole(['super_admin','super_usuario','ceo','admin']);
    }
    // Notificações internas geradas pelos processos agendados.
    match /notifications/{id} {
      allow read: if signedIn() && (
        owner() ||
        (resource.data.targetEmail is string && request.auth.token.email.lower() == resource.data.targetEmail.lower())
      );
      allow update: if signedIn()
        && resource.data.targetEmail is string
        && request.auth.token.email.lower() == resource.data.targetEmail.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
      allow create, delete: if false;
    }

    // Agenda pública: visitantes podem solicitar uma visita; só a equipa consulta e gere.
    match /visits/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','phone','service','address','preferDate','preferTime'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.service is string && request.resource.data.service.size() <= 300;
      allow read: if canOperate();
      allow update, delete: if canManageCommercial();
    }
    match /agenda_slots/{id} { allow read: if canOperate(); allow create, update, delete: if canManageCommercial(); }

    // Financeiro: acesso restrito a perfis financeiros e direção.
    match /suppliers/{id} { allow read, write: if canManageFinance(); }
    match /purchase_orders/{id} { allow read, write: if canManageFinance(); }
    match /inventory_items/{id} { allow read: if canManageInventory() || canManageProduction(); allow create, update: if canManageInventory(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /inventory_movements/{id} { allow read: if canManageInventory() || canManageProduction(); allow create: if canManageInventory(); allow update, delete: if owner(); }
    match /production_orders/{id} { allow read: if canManageProduction() || canManageQuality(); allow create, update: if canManageProduction(); allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']); }
    match /payables/{id} { allow read, write: if canManageFinance(); }
    match /receivables/{id} { allow read, update, delete: if canManageFinance(); allow create: if canManageFinance() || canManageCommercial(); }
    match /pending_boletos/{id} { allow read, write: if canManageFinance(); }
    // Documentos fiscais importados: Financeiro pode criar como pendentes;
    // somente direção/admin pode autorizar ou rejeitar.
    match /fiscal_documents/{id} {
      allow read: if canManageFinance();
      allow create: if canManageFinance()
        && request.resource.data.status == 'pending_admin'
        && request.resource.data.adminApprovalRequired == true;
      allow update: if hasRole(['super_admin','super_usuario','ceo','admin'])
        && resource.data.status == 'pending_admin'
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.approvedByUid == request.auth.uid;
      allow delete: if hasRole(['super_admin','super_usuario','ceo','admin']);
    }
    match /payments/{id} { allow read, write: if canManageFinance(); }
    match /company_payment_settings/{id} { allow read, write: if canManageFinance(); }

    // Pessoas e folha salarial: confidencialidade reforçada.
    match /employees/{id} { allow read, write: if hasRole(['super_admin','super_usuario','ceo','admin','rh','financeiro']); }
    match /time_entries/{id} { allow read, write: if hasRole(['super_admin','super_usuario','ceo','admin','rh','financeiro','supervisor']); }
    match /payroll_settings/{id} { allow read, write: if hasRole(['super_admin','super_usuario','ceo','admin','rh','financeiro']); }
    match /payroll_runs/{id} { allow read, write: if hasRole(['super_admin','super_usuario','ceo','admin','rh','financeiro']); }
    match /payroll_adjustments/{id} { allow read, write: if hasRole(['super_admin','super_usuario','ceo','admin','rh','financeiro']); }
    match /employee_payments/{id} { allow read, write: if hasRole(['super_admin','super_usuario','ceo','admin','rh','financeiro']); }

    // Qualidade e pós-venda: registos operacionais e rastreabilidade.
    match /post_sale_records/{id} { allow read, write: if canManageQuality(); }
    match /deliveries/{id} { allow read, write: if canManageQuality(); }
    match /audit_logs/{id} {
      allow read: if hasRole(['super_admin','super_usuario','ceo','admin']);
      allow create: if owner() || hasRole(['super_admin','super_usuario','ceo','admin']);
      allow update, delete: if owner();
    }
    match /sender_config/{id} { allow read: if canOperate(); allow create, update: if hasRole(['super_admin','super_usuario','ceo','admin']); allow delete: if owner(); }

    // Negação por padrão: nenhuma coleção não declarada fica acessível por estar autenticado.
    match /{document=**} { allow read, write: if false; }
  }
}