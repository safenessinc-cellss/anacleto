rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'safeness.c.a@gmail.com';
    }
    function adminPath() {
      return /databases/(default)/documents/admins/$(request.auth.token.email.lower());
    }
    function hasAdminRecord() {
      return signedIn() && request.auth.token.email != null && firestore.exists(adminPath());
    }
    function canManageQuality() {
      return owner() || (hasAdminRecord()
        && firestore.get(adminPath()).data.role in ['super_admin','super_usuario','ceo','admin','supervisor','colaborador','qualidade']);
    }
    function canManageFinance() {
      return owner() || (hasAdminRecord()
        && firestore.get(adminPath()).data.role in ['super_admin','super_usuario','ceo','admin','financeiro']);
    }
    match /purchases/{purchasePath=**} {
      allow read: if canManageFinance();
      allow create, update: if canManageFinance()
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/(jpeg|png|webp)'));
      allow delete: if owner();
    }
    match /deliveries/{deliveryId}/{fileName} {
      allow read: if canManageQuality();
      allow create, update: if canManageQuality()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if owner();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
